diff --git a/grammar/statements/tcl.js b/grammar/statements/tcl.js
new file mode 100644
index 0000000..d5137af
--- /dev/null
+++ b/grammar/statements/tcl.js
@@ -0,0 +1,89 @@
+// Savepoint + privilege statements.
+// `transaction` (BEGIN...COMMIT/ROLLBACK) already handled by upstream
+// transactions.js. Only adds what's missing.
+
+export default {
+
+  // SAVEPOINT name
+  _tcl_savepoint: $ => seq(
+    $.keyword_savepoint,
+    $.identifier,
+  ),
+
+  // RELEASE [SAVEPOINT] name
+  _tcl_release: $ => seq(
+    $.keyword_release,
+    optional($.keyword_savepoint),
+    $.identifier,
+  ),
+
+  // ROLLBACK TO [SAVEPOINT] name -- savepoint rollback (not transaction end)
+  _tcl_rollback_to: $ => seq(
+    $.keyword_rollback,
+    $.keyword_to,
+    optional($.keyword_savepoint),
+    $.identifier,
+  ),
+
+  tcl_statement: $ => choice(
+    $._tcl_savepoint,
+    $._tcl_release,
+    $._tcl_rollback_to,
+  ),
+
+  // GRANT privs [ON obj] TO grantee
+  grant_statement: $ => prec.left(seq(
+    $.keyword_grant,
+    choice(
+      $.keyword_all,
+      seq(
+        choice($.keyword_select, $.keyword_insert, $.keyword_update,
+               $.keyword_delete, $.keyword_truncate, $.keyword_references,
+               $.keyword_trigger, $.keyword_execute, $.keyword_usage),
+        repeat(seq(',',
+          choice($.keyword_select, $.keyword_insert, $.keyword_update,
+                 $.keyword_delete, $.keyword_truncate, $.keyword_references,
+                 $.keyword_trigger, $.keyword_execute, $.keyword_usage),
+        )),
+      ),
+    ),
+    optional(seq($.keyword_on,
+      optional(choice($.keyword_table, $.keyword_schema, $.keyword_database,
+                      $.keyword_function, $.keyword_sequence)),
+      $.object_reference,
+      repeat(seq(',', $.object_reference)),
+    )),
+    $.keyword_to,
+    choice($.identifier, $.keyword_public, $.keyword_current_user),
+    repeat(seq(',', choice($.identifier, $.keyword_public, $.keyword_current_user))),
+    optional(seq($.keyword_with, $.keyword_grant, $.keyword_option)),
+  )),
+
+  // REVOKE privs [ON obj] FROM grantee
+  revoke_statement: $ => prec.left(seq(
+    $.keyword_revoke,
+    choice(
+      $.keyword_all,
+      seq(
+        choice($.keyword_select, $.keyword_insert, $.keyword_update,
+               $.keyword_delete, $.keyword_truncate, $.keyword_references,
+               $.keyword_trigger, $.keyword_execute, $.keyword_usage),
+        repeat(seq(',',
+          choice($.keyword_select, $.keyword_insert, $.keyword_update,
+                 $.keyword_delete, $.keyword_truncate, $.keyword_references,
+                 $.keyword_trigger, $.keyword_execute, $.keyword_usage),
+        )),
+      ),
+    ),
+    optional(seq($.keyword_on,
+      optional(choice($.keyword_table, $.keyword_schema, $.keyword_database,
+                      $.keyword_function, $.keyword_sequence)),
+      $.object_reference,
+      repeat(seq(',', $.object_reference)),
+    )),
+    $.keyword_from,
+    choice($.identifier, $.keyword_public, $.keyword_current_user),
+    repeat(seq(',', choice($.identifier, $.keyword_public, $.keyword_current_user))),
+  )),
+
+};
