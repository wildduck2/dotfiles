Host *
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_ed25519
  ServerAliveInterval 30
  ServerAliveCountMax 4

# MacBook on the home LAN, by its Bonjour name: the router hands it a new address now and then
Host mac
  HostName wildducks-MacBook-Air.local
  User wildduck
  # Its key is filed under "mac", so a new address never asks to trust it again.
  HostKeyAlias mac

# One connection reused by every ssh to the Mac, so clip-to-mac.sh on Ctrl+V is quick
Host mac wildducks-MacBook-Air.local
  ControlMaster auto
  ControlPath ~/.ssh/cm-%C
  ControlPersist 10m
