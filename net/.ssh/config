Host *
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_ed25519
  ServerAliveInterval 30
  ServerAliveCountMax 4

# MacBook on the home LAN
Host mac
  HostName 192.168.1.28
  User wildduck

# One connection reused by every ssh to the Mac, so clip-to-mac.sh on Ctrl+V is quick
Host mac 192.168.1.28
  ControlMaster auto
  ControlPath ~/.ssh/cm-%C
  ControlPersist 10m
