# sway config - Wayland port kept in parity with i3 (~/.config/i3/config)
#
# This machine is NVIDIA (RTX 5070 Ti Laptop), so start sway with:  sway --unsupported-gpu
# Keep i3 installed as a fallback. Anything X11-only in i3 is swapped for a Wayland tool here,
# and the shared logic (keys.sh, hibernate.sh, lock.sh, startup.sh) lives in this package.

# -------------------------------------------
# Catppuccin Mocha Theme
# -------------------------------------------
set $rosewater #f5e0dc
set $flamingo #f2cdcd
set $pink #f5c2e7
set $mauve #cba6f7
set $red #f38ba8
set $maroon #eba0ac
set $peach #fab387
set $yellow #f9e2af
set $green #a6e3a1
set $teal #94e2d5
set $sky #89dceb
set $sapphire #74c7ec
set $blue #89b4fa
set $lavender #b4befe
set $text #cdd6f4
set $subtext1 #bac2de
set $subtext0 #a6adc8
set $overlay2 #9399b2
set $overlay1 #7f849c
set $overlay0 #6c7086
set $surface2 #585b70
set $surface1 #45475a
set $surface0 #313244
set $base #1e1e2e
set $mantle #181825
set $crust #11111b

# target                 title     bg    text      indicator    border
client.focused           $mantle   $mauve $mantle  $rosewater $mauve
client.focused_inactive  $overlay0 $base  $text    $rosewater $overlay0
client.unfocused         $overlay0 $base  $text    $rosewater $overlay0
client.urgent            $peach    $base  $peach   $overlay0  $peach
client.placeholder       $overlay0 $base  $text    $overlay0  $overlay0
client.background        $base

# -------------------------------------------
# General Settings
# -------------------------------------------
set $mod Mod1

# Fonts
font pango:Berkeley Mono Trial 16px

gaps inner 2
gaps outer 0
smart_gaps off

# Remove window borders (native and Xwayland)
for_window [app_id=".*"] border pixel 0
for_window [class=".*"] border pixel 0

# Flameshot's capture surface: float it fullscreen and borderless so it behaves like the
# X11 overlay (dimmed whole screen) instead of being tiled as an ordinary window.
for_window [app_id="flameshot"] floating enable, border none, fullscreen enable

# Use Mouse+$mod to drag floating windows
floating_modifier $mod

# -------------------------------------------
# Input
# -------------------------------------------
input type:keyboard {
    xkb_layout us
    repeat_delay 300
    repeat_rate 50
}

input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

# -------------------------------------------
# Output / Monitors - max resolution & refresh rate
# -------------------------------------------
# External monitor on the LEFT (name varies by port, so set them all)
output DP-5 mode 1920x1080@120.000Hz position 0 0
output DP-1 mode 1920x1080@120.000Hz position 0 0
output DP-2 mode 1920x1080@120.000Hz position 0 0
output DP-3 mode 1920x1080@120.000Hz position 0 0
output DP-1-3 mode 1920x1080@120.000Hz position 0 0

# Laptop display on the RIGHT
output eDP-1 mode 2560x1600@240.000Hz position 1920 0

# Adaptive sync (VRR)
output * adaptive_sync on

# Wallpaper on all outputs
output * bg ~/.config/sway/bgs/bg.jpg fill

# Workspace-to-monitor bindings
workspace 1 output DP-5 DP-1 DP-2 DP-3 DP-1-3
workspace 2 output DP-5 DP-1 DP-2 DP-3 DP-1-3
workspace 5 output eDP-1

# -------------------------------------------
# Key Bindings - Essentials
# -------------------------------------------
bindsym $mod+Return exec terminator
bindsym $mod+q kill
# dmenu: Mod+d for apps, Mod+Shift+d for all binaries
bindsym $mod+d exec --no-startup-id dmenu_path | dmenu | xargs swaymsg exec --
bindsym $mod+Shift+d exec --no-startup-id dmenu_run

# Quick-launch apps
bindsym $mod+Ctrl+p exec --no-startup-id pavucontrol
bindsym $mod+Ctrl+b exec --no-startup-id blueman-manager

# -------------------------------------------
# Key Bindings - Focus (vim-style)
# -------------------------------------------
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# -------------------------------------------
# Key Bindings - Move Window (vim-style)
# -------------------------------------------
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# -------------------------------------------
# Key Bindings - Layout
# -------------------------------------------
bindsym $mod+z split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+a focus parent

# -------------------------------------------
# Workspaces
# -------------------------------------------
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10

bindsym $mod+m move workspace to output left

# -------------------------------------------
# Key Bindings - Sway Management
# -------------------------------------------
bindsym $mod+Shift+c reload
# i3 had "restart" here; sway has no X session to restart, so reload covers it.
bindsym $mod+Shift+r reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -b 'Yes, exit sway' 'swaymsg exit'

# -------------------------------------------
# Resize Mode
# -------------------------------------------
mode "resize" {
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"

# -------------------------------------------
# Bar (waybar) - swaybar's Wayland tray cannot show the apps' native menus, waybar can.
# -------------------------------------------
# Started from the Autostart section below. Config/styles in ~/.config/waybar/.
# No bar {} block here, that would launch swaybar as a second bar.

# -------------------------------------------
# Media & Hardware Keys
# -------------------------------------------
# Same popups as i3: keys.sh drives volume/mute/mic/brightness/touchpad (wpctl/pactl/busctl, all
# Wayland-safe; its touchpad case uses swaymsg here instead of xinput).
set $keys ~/.config/sway/keys.sh
bindsym XF86AudioRaiseVolume exec --no-startup-id $keys volume +5
bindsym XF86AudioLowerVolume exec --no-startup-id $keys volume -5
bindsym XF86AudioMute exec --no-startup-id $keys mute
bindsym XF86AudioMicMute exec --no-startup-id $keys mic
bindsym XF86MonBrightnessUp exec --no-startup-id $keys brightness +5
bindsym XF86MonBrightnessDown exec --no-startup-id $keys brightness -5
bindsym XF86TouchpadToggle exec --no-startup-id $keys touchpad
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioPause exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# -------------------------------------------
# Custom Key Bindings
# -------------------------------------------
bindsym $mod+Shift+period exec systemctl suspend
bindsym $mod+Ctrl+Shift+period exec --no-startup-id ~/.config/sway/hibernate.sh
# F9 in Minecraft holds left click until pressed again (Minecraft runs under Xwayland, xdotool reaches it).
bindsym F9 exec --no-startup-id ~/dotfiles/minecraft/hold-attack.sh
# Screenshots via flameshot, same bindings as i3 (needs xdg-desktop-portal-wlr, installed by setup.sh).
# Region/GUI capture:
bindsym Ctrl+Print exec --no-startup-id env QT_OPENGL=software flameshot gui
# Instant full capture to clipboard + ~/Pictures/Screenshots:
bindsym Print exec --no-startup-id flameshot full -c -p ~/Pictures/Screenshots/
# Lock screen (swaylock, Catppuccin)
bindsym $mod+Ctrl+l exec --no-startup-id ~/.config/sway/lock.sh
bindsym $mod+x exec --no-startup-id ~/.config/sway/lock.sh

# Clipboard history (cliphist + dmenu)
bindsym $mod+Shift+v exec --no-startup-id cliphist list | dmenu -l 15 | cliphist decode | wl-copy

# -------------------------------------------
# Autostart
# -------------------------------------------
# Make the Wayland session env available to dbus-activated and systemd user services. The
# xdg-desktop-portal-wlr backend needs WAYLAND_DISPLAY to take screenshots, and flameshot v15
# captures only through that portal, so without this flameshot errors with "backend did not respond".
exec --no-startup-id dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
exec --no-startup-id systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
# Restart the portals once the env is imported, in case they autostarted earlier without it.
exec --no-startup-id sh -c 'sleep 1; systemctl --user restart xdg-desktop-portal xdg-desktop-portal-wlr'

# Notification daemon: keys.sh popups and app notifications need one running.
exec --no-startup-id dunst
# Status bar (waybar, for a working system-tray menu).
exec --no-startup-id waybar
exec --no-startup-id gnome-settings-daemon
exec --no-startup-id nm-applet --indicator
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
# Quote the whole command: sway splits an unquoted exec line on commas, so pkcs11,secrets,ssh
# would be parsed as three separate commands ("Unknown/invalid command 'secrets'").
exec --no-startup-id "gnome-keyring-daemon --start --components=pkcs11,secrets,ssh"
exec --no-startup-id blueman-applet
# flameshot daemon: needed for its tray icon to appear in the bar and for captures to be ready.
exec --no-startup-id flameshot
# Lock before any suspend/hibernate, so the machine always wakes to the lock screen (replaces xss-lock).
exec --no-startup-id swayidle -w before-sleep ~/.config/sway/lock.sh
# Clipboard history watchers
exec --no-startup-id wl-paste --type text --watch cliphist store
exec --no-startup-id wl-paste --type image --watch cliphist store
exec --no-startup-id mechvibes --disable-gpu --no-sandbox
exec --no-startup-id pactl load-module module-null-sink sink_name=OBS_VirtualMic sink_properties=device.description=OBS_VirtualMic
# exec, not exec_always: this opens apps and moves workspaces, so running it on every reload
# (mod+Shift+r/c) would relaunch everything and jump focus. Login-only; reload just refreshes.
exec --no-startup-id ~/.config/sway/startup.sh
